# Copie para .env.local e preencha com os valores reais do projeto Supabase.
# Nunca commite .env.local — ele já está no .gitignore.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — nunca prefixar com NEXT_PUBLIC_. Usado só em código de servidor
# (ex: convite de usuários via auth.admin.inviteUserByEmail).
SUPABASE_SECRET_KEY=

# Usado pelo fluxo de convite para montar o link de redirecionamento.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
